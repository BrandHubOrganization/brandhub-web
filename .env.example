# ============================================================
# BrandHub Web Dashboard environment example
# Copy this file to .env for local Vite development.
# Do not commit .env.
#
# Vite exposes only VITE_* variables to the browser bundle.
# In Docker production, nginx can proxy /api to api-gateway, but the current
# source reads VITE_API_BASE_URL directly in src/services/api.ts.
# ============================================================

VITE_API_BASE_URL=http://localhost:8080
# Optional; defaults to VITE_API_BASE_URL with ws/wss scheme plus /ws/chat.
VITE_WS_BASE_URL=ws://localhost:8080/ws/chat
VITE_AI_ASSET_BASE_URL=http://localhost:8082
VITE_APP_NAME=BrandHub

# Optional dev quick-login email overrides for an older local seed dataset.
# Defaults match Business SeedScale. Put overrides in .env.development.local.
# VITE_DEV_LOGIN_ADMIN_EMAIL=
# VITE_DEV_LOGIN_OWNER_EMAIL=
# VITE_DEV_LOGIN_MANAGER_EMAIL=
# VITE_DEV_LOGIN_CREATOR_EMAIL=
# VITE_DEV_LOGIN_CLIENT_EMAIL=

# Google OAuth credentials belong in brandhub-business-service/.env.
# The browser starts OAuth through VITE_API_BASE_URL.
