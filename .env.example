# ============================================================
# BrandHub Web Dashboard environment example
# Copy this file to .env for local Vite development.
# Do not commit .env.
#
# Vite exposes only VITE_* variables to the browser bundle.
# In Docker production, nginx can proxy /api to api-gateway, but the current
# source reads VITE_API_BASE_URL directly in src/services/api.ts.
# ============================================================

VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=BrandHub
